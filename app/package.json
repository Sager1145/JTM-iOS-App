{
  "name": "n02-train-manager",
  "version": "1.0.0",
  "description": "Railway journey manager — static frontend and retained artifact builders",
  "type": "commonjs",
  "scripts": {
    "start": "node scripts/build/serve-static.mjs",
    "dev": "npm run dev:static",
    "test": "node --test",
    "build:db": "node scripts/build/build-rail-database.mjs",
    "build:station-names": "python3 scripts/railway/build-station-names.py",
    "build:station-english": "python3 scripts/railway/build-jp-station-english.py && python3 scripts/railway/build-station-english.py",
    "precompute": "node scripts/build/precompute-train-parts.mjs",
    "precompute:tw": "PRECOMPUTE_COUNTRY=tw PRECOMPUTE_STORE=data/train-store-tw.json PRECOMPUTE_OUT_DIR=data/sample-data-tw node scripts/build/precompute-train-parts.mjs",
    "precompute:hk": "PRECOMPUTE_COUNTRY=hk PRECOMPUTE_STORE=data/train-store-hk.json PRECOMPUTE_OUT_DIR=data/sample-data-hk node scripts/build/precompute-train-parts.mjs",
    "precompute:mo": "PRECOMPUTE_COUNTRY=mo PRECOMPUTE_STORE=data/train-store-mo.json PRECOMPUTE_OUT_DIR=data/sample-data-mo node scripts/build/precompute-train-parts.mjs",
    "precompute:kr": "PRECOMPUTE_COUNTRY=kr PRECOMPUTE_STORE=data/train-store-kr.json PRECOMPUTE_OUT_DIR=data/sample-data-kr node scripts/build/precompute-train-parts.mjs",
    "precompute:new-year-grand-loop": "PRECOMPUTE_STORE=data/special-samples/new-year-grand-loop.json PRECOMPUTE_OUT_DIR=data/new-year-grand-loop-data node scripts/build/precompute-train-parts.mjs",
    "precompute:tokyo-limited-express-loop": "PRECOMPUTE_STORE=data/special-samples/tokyo-limited-express-loop.json PRECOMPUTE_OUT_DIR=data/tokyo-limited-express-loop-data node scripts/build/precompute-train-parts.mjs",
    "build:static": "node scripts/build/build-static-site.mjs",
    "serve:static": "node scripts/build/serve-static.mjs",
    "dev:static": "npm run build:static && node scripts/build/serve-static.mjs",
    "build": "npm run precompute && npm run precompute:tw && npm run precompute:hk && npm run precompute:mo && npm run precompute:kr && npm run precompute:new-year-grand-loop && npm run precompute:tokyo-limited-express-loop && npm run build:static"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.5.0"
  }
}

{
  "schema_version": "1",
  "title": "Reviewed Japanese railway identity-event seeds",
  "scope": "Primary-source exact-day seeds for H1 review; this file is not a runtime overlay.",
  "status_definitions": {
    "reviewed_seed": "The exact date, identity, and surveyed selector are reviewed for promotion; the selector may target a current identity, an isolated current/historical segment, or an exact historical station.",
    "reviewed_source_only": "The exact source row is reviewed, but promotion must wait for historical geometry, a predecessor-identity dependency or an isolated segment selector.",
    "ready_whole_identity": "The official interval is the full extent of one current line/operator identity.",
    "ready_current_station": "The current station point has an exact unique N02 identity.",
    "unresolved_segment_selector": "The current identity opened in stages; station-to-station historical geometry is required.",
    "unresolved_historical_geometry": "The event-date surveyed geometry or predecessor railway identity is incomplete; present geometry cannot be backdated without evidence.",
    "ready_isolated_segment": "A verified canonical bbox/name selector isolates the intended current and historical segment without treating a staged identity as a whole.",
    "ready_historical_station": "A verified canonical old-release name/bbox selector isolates an absent current station from surveyed historical geometry."
  },

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Debug configuration only (INFOPLIST_FILE[Debug] of the RailMap target):
     registers the test control channel's URL scheme. Release has no
     INFOPLIST_FILE, so the scheme never ships. See ios/tools/app-control.py. -->
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.JRM.RailMap.app-control</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>railmap-test</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
